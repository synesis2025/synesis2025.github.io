  <pubDate>Sun, 20 Sep 2020 07:00:00 GMT</pubDate>
  <media:content url="https://benjaminhan.net/posts/20200920-huangs-law-gpt3/cover.jpg" medium="image" type="image/jpeg"/>
</item>
